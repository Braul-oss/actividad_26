# Única configuración de la app: la dirección pública de la API.
# NUNCA coloques aquí contraseñas de base de datos, llaves de almacenamiento ni JWT_SECRET:
# todo lo que lleva el prefijo EXPO_PUBLIC_ queda visible dentro del instalador.
# En producción debe ser una URL https://
EXPO_PUBLIC_API_URL=http://localhost:8095
